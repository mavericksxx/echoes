{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "echoes",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // Wrangler runs this before bundling on *every* `wrangler dev`/`wrangler
  // deploy` — including one typed directly, with no npm script (and
  // therefore no `npm run check:data`) anywhere in the loop. Fails loudly
  // (non-zero exit aborts the deploy) if dist/assets/ is missing any sprite
  // PNG data/assets.json expects — a `wrangler deploy` run this way already
  // shipped a spriteless village once. See scripts/check-dist-assets.mjs's
  // doc comment for why this can't just be an npm `predeploy` script.
  "build": {
    "command": "node scripts/check-dist-assets.mjs"
  },
  "routes": [{ "pattern": "echoes.parthkohale.com", "custom_domain": true }],
  "observability": {
    "enabled": true
  },
  // Phase 8a: play-event log. Every 15 min, worker/index.ts's `scheduled()`
  // calls worker/history.ts's runHistorySync to backfill recently-played —
  // see that file for the active-429-ban check that runs before any of this
  // ever touches Spotify.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    // Public PKCE client id — there is no client secret for this app. Safe
    // to commit (see SPEC.md's "Auth & tokens" section).
    "SPOTIFY_CLIENT_ID": "d0f1c1c011cf4ae0bed185a84b483208"
  },
  // TOKEN_KEY (the AES-GCM key used to encrypt the stored refresh token) is
  // a secret, not a var — see README.md's "Connect your Spotify account".
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "echoes",
      "database_id": "1f8abb15-651a-47db-bfcb-40f4ac1c5065"
    }
  ]
}
