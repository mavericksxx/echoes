{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "echoes",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "routes": [{ "pattern": "echoes.parthkohale.com", "custom_domain": true }],
  "observability": {
    "enabled": true
  }
}
