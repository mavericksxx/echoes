{
  "name": "echoes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "check:data": "node scripts/check-data.mjs",
    "check:dist-assets": "node scripts/check-dist-assets.mjs",
    "assets:sync": "node scripts/sync-assets.mjs",
    "db:migrate:local": "wrangler d1 migrations apply echoes --local",
    "db:migrate:remote": "wrangler d1 migrations apply echoes --remote",
    "spotify:connect": "node scripts/spotify-connect.mjs",
    "spotify:disconnect": "node scripts/spotify-disconnect.mjs",
    "gemini:smoke": "node scripts/gemini-smoke.mjs",
    "deploy": "npm run check:data && npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.131.2"
  }
}
